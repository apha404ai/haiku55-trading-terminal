# HAIKU55 uses real PUBLIC market mids; no exchange keys.
# PAPER ONLY: no real transaction signing or sending.
PORT=8080
DB_PATH=data/haiku55.db
STARTING_BALANCE=10000
AUTO_PAPER=1
POLL_SECONDS=5
SCAN_SECONDS=60

# Set a random secret of at least 32 characters on the deployment platform.
# Required for all POST controls; NEVER commit the actual token.
CONTROL_TOKEN=

# Optional. Set AI_MODE=1 only after configuring all four API keys
# AND the provider-specific model IDs below.
# Missing models/keys => signals WAIT, no false AI votes or AI-driven orders.
AI_MODE=0
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=
XAI_API_KEY=
XAI_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
